var tick: int
var kind: Kind
var entity_id: int
var detail: String
# Finalized by the organization system before this tick is published.
var applied_amount: float = 0.0


func _init(new_tick: int, new_kind: Kind, new_entity_id: int, new_detail: String = "") -> void:
	tick = new_tick
	kind = new_kind
	entity_id = new_entity_id
	detail = new_detail
