	ORE_DELIVERED,
	PRODUCTION_STARTED,
	UNIT_PRODUCED,
	FACTION_DEFEATED,
	FACTION_VICTORIOUS,
	TASK_STATE_CHANGED,
	UNIT_CONTROL_CHANGED,
	UNIT_REJOIN_STARTED,
	UNIT_REJOIN_COMPLETED,
	BUILDING_PLACED,
	CONSTRUCTION_COMPLETED,
	REPAIR_STARTED,
	BUILDING_REPAIRED,
	BUILDING_DESTROYED,
	HARVEST_CARGO_LOADED,
	ENEMY_PHASE_CHANGED,
	PRODUCTION_QUEUED,
	PRODUCTION_CANCELLED,
	RALLY_POINT_SET,
	UNIT_CARD_DEPLOYMENT_STARTED,
